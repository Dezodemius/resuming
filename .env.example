# Ollama (запускается на этом же сервере)
OLLAMA_URL=http://localhost:11434
# ВНИМАНИЕ: qwen2.5:14b требует ~10+ ГБ свободной RAM (без GPU).
# Если памяти меньше — llama-server убивает OOM-killer и сайт отдаёт 502.
# Для серверов с 8 ГБ RAM используйте qwen2.5:7b, с 4 ГБ — qwen2.5:3b.
OLLAMA_MODEL=qwen2.5:14b

# Вместо локальной Ollama можно указать любой OpenAI-совместимый API
# (DeepSeek, OpenAI и т.п.) — OLLAMA_URL/OLLAMA_MODEL указывают на него,
# AI_API_KEY добавляет заголовок Authorization: Bearer. На app01 (мало RAM)
# используется именно так: OLLAMA_URL=https://api.deepseek.com,
# OLLAMA_MODEL=deepseek-v4-flash.
AI_API_KEY=

# Telegram Login (создать бота через @BotFather)
# /newbot → получить токен → /setdomain → указать домен сервера
TELEGRAM_BOT_TOKEN=1234567890:ABCdef...
TELEGRAM_BOT_NAME=MyResumeBot

# Email (Яндекс SMTP — бесплатно)
# Яндекс: Настройки → Безопасность → Пароли приложений → создать пароль для почты
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your@yandex.ru
SMTP_PASS=app_password_here
SMTP_FROM=your@yandex.ru

# Робокасса (личный кабинет: https://docs.robokassa.ru)
# ResultURL/SuccessURL/FailURL настраиваются в личном кабинете Робокассы, а не тут:
# ResultURL = {APP_URL}/api/pay/webhook, SuccessURL = {APP_URL}/new?paid=1
ROBOKASSA_LOGIN=my-shop
ROBOKASSA_PASSWORD1=pass1...
ROBOKASSA_PASSWORD2=pass2...
# 1 — тестовый режим (IsTest=1, без реальных списаний, нужен тестовый магазин)
ROBOKASSA_TEST_MODE=0

# Яндекс OAuth (создать приложение: https://oauth.yandex.ru/client/new)
# Redirect URI: {APP_URL}/auth/yandex/callback
# Права: login:email + login:info
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# VK ID OAuth (новый протокол https://id.vk.com)
# Создать приложение: https://id.vk.com/about/business/go/docs/developer/
# Redirect URI: {APP_URL}/auth/vk/callback
# Нужен только «ID приложения» из кабинета VK ID. «Защищённый ключ» и
# «Сервисный ключ доступа» НЕ используются: обмен кода идёт по PKCE без секрета.
VK_CLIENT_ID=

# Mail.ru OAuth (создать приложение: https://oauth.mail.ru)
# Redirect URI: {APP_URL}/auth/mailru/callback
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=

# Общий рубильник кнопок входа через Яндекс/VK/Mail.ru: 0 (по умолчанию) —
# кнопки скрыты и роуты /auth/{yandex,vk,mailru} отдают 503, даже если
# CLIENT_ID выше настроены. Поставьте 1, когда сторонняя авторизация снова
# стабильна и её нужно включить.
OAUTH_LOGIN_ENABLED=0

# Публичный URL (без слеша в конце). Кириллический домен можно указывать
# как есть — хост автоматически приводится к punycode (xn--…) для OAuth и CORS.
APP_URL=https://your-domain.com
# ОБЯЗАТЕЛЕН при https-значении APP_URL: без него приложение не стартует.
# Случайный ключ на каждый рестарт обнулял бы подпись anon-cookie, а вместе с
# ней и лимит бесплатных превью. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here-change-me
AI_CONCURRENCY=2   # max параллельных вызовов Ollama
LOG_LEVEL=INFO     # DEBUG / INFO / WARNING
# Каталог файловых логов (ротация 10 МБ × 5: app.log, app.log.1 … app.log.5).
# По умолчанию — <DATA_DIR>/logs (на app_data volume). Оставьте пустым для дефолта.
LOG_DIR=

# Ops MCP-сервер (прод-диагностика; наружу через nginx за Cloudflare-прокси).
# Длинная случайная строка — Bearer-токен; без неё контейнер ops-mcp не стартует.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPS_MCP_TOKEN=

# Админ-почты (через запятую, им доступна страница /admin для создания промокодов и статистики)
ADMIN_EMAILS=

# Яндекс.Метрика (номер счётчика для аналитики; пусто = выключено)
METRIKA_ID=

# ── Безопасность и обслуживание ──────────────────────────────────────────
# Content-Security-Policy: enforce (по умолчанию) | report | off.
# Аварийный вентиль: если сторонний скрипт вдруг начал блокироваться —
# переключите на report, перезапустите app и посмотрите консоль браузера.
CSP_MODE=enforce

# Глобальный лимит запросов (240/мин на IP). 0 отключает — только для отладки.
RATE_LIMIT_ENABLED=1

# Фоновая уборка БД: как часто и сколько хранить служебные записи.
CLEANUP_INTERVAL_SEC=3600
ANON_USAGE_TTL_DAYS=30
EVENTS_TTL_DAYS=180
