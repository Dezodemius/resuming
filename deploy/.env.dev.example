# .env дев-стенда на app-01 — кладётся в /srv/apps/resuming-dev/.env
#
# Это НЕ копия боевого .env с правками. Боевые ключи сюда переносить нельзя:
# стенд рассылал бы письма и дёргал бы Робокассу от лица прода. Всё, что здесь
# пусто, — пусто намеренно.
#
# Проверка на стороне выката: deploy/deploy-dev.sh откажется работать, если
# APP_URL начинается с https или если нет DEV_MODE=1.

# ── Что делает контур дев-стендом ───────────────────────────────────────────
# /dev и /api/dev/* — вход по любой почте и выдача себе тарифа без оплаты.
DEV_MODE=1

# Обязательно http и обязательно localhost: config.py гасит DEV_MODE при
# https-значении, а session-cookie с Secure не вернулась бы через туннель.
APP_URL=http://localhost:8002

# Адрес публикации порта. 127.0.0.1 — стенд виден только изнутри машины,
# заходят SSH-туннелем. 0.0.0.0 открывает 8002 всему интернету, и без правила
# ufw на конкретный адрес это значит «вход любым аккаунтом кому угодно».
DEV_BIND=127.0.0.1

# Свой, не боевой. Сгенерировать:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# ── AI ──────────────────────────────────────────────────────────────────────
# Тот же внешний OpenAI-совместимый провайдер, что и у прода (локальной Ollama
# на app-01 нет — не хватает RAM). Ключ отдельный, если провайдер это умеет:
# счётчик расхода стенда не должен смешиваться с боевым.
OLLAMA_URL=https://api.deepseek.com
OLLAMA_MODEL=deepseek-v4-flash
AI_API_KEY=

# ── Намеренно выключено ─────────────────────────────────────────────────────
# Почта: без SMTP_USER magic-ссылка печатается в stdout контейнера
# (docker logs resuming-dev-app), а на стенде вход всё равно идёт через /dev.
SMTP_USER=
SMTP_PASS=

# Робокасса: платить на стенде нечем и незачем — тариф выдаётся через /dev.
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=

# OAuth: redirect_uri у провайдеров зарегистрирован на боевой домен, с
# localhost:8002 вход всё равно не пройдёт.
OAUTH_LOGIN_ENABLED=0

# Метрика: события стенда не должны попадать в боевую статистику.
METRIKA_ID=

# ── Прочее ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
# Пусто = не ограничивать по адресам. Стенд и так закрыт сетью, а через туннель
# приложение видит адрес docker-шлюза, а не ваш.
ADMIN_IPS=
ADMIN_EMAILS=you@example.com
# Лимитер оставлен включённым: на стенде проверяют в том числе и его. Мешает
# нагрузочным прогонам — временно RATE_LIMIT_ENABLED=0.
RATE_LIMIT_ENABLED=1
CSP_MODE=enforce
