# .env стенда timeweb.cloud. Скопируй в deploy/.env.staging и заполни.
#
#   cp deploy/.env.staging.example deploy/.env.staging
#
# ВАЖНО: не копируй сюда продовый .env. Боевые ключи Робокассы на стенде без
# ROBOKASSA_TEST_MODE=1 — это реальные списания с карт при каждом тесте
# оплаты; deploy.sh специально отказывается заливать такую комбинацию.

# ── Ollama ───────────────────────────────────────────────────────────────
# На стенде Ollama НЕ поднимается: адрес указывает на внешнюю машину
# (домашний прод, отдельный GPU-сервер, туннель). Порт 11434 должен быть
# доступен со стенда, а на той машине Ollama — слушать не только localhost
# (OLLAMA_HOST=0.0.0.0). Модель должна совпадать с загруженной там.
OLLAMA_URL=http://ollama-host-or-ip:11434
OLLAMA_MODEL=qwen2.5:14b

# ── Публичный адрес стенда ───────────────────────────────────────────────
# Ровно тот адрес, по которому открываешь стенд. Схема http: TLS на стенде
# нет, а при https-значении приложение потребует SECRET_KEY и выставит
# Secure-cookie, которые по http не долетят.
APP_URL=http://СТЕНД_IP

# Обязателен и на стенде: без него подпись anon-cookie меняется при каждом
# рестарте и лимит бесплатных превью обнуляется.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Логи и AI ────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_DIR=
AI_CONCURRENCY=1

# ── Платежи ──────────────────────────────────────────────────────────────
# Тестовый магазин Робокассы (demo, см. docs.robokassa.ru/ru/demo-shops) с
# ROBOKASSA_TEST_MODE=1, или пусто, если оплату не проверяем.
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_MODE=1

# ── Вход ─────────────────────────────────────────────────────────────────
# Redirect URI у OAuth-провайдеров должен указывать на APP_URL стенда,
# иначе вход отвалится — заведи отдельные тестовые приложения или оставь
# пусто и логинься по email magic link.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=

# Без SMTP_USER magic-ссылка печатается в логи приложения — для стенда
# это нормально: ./deploy/deploy.sh --logs 100
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Прочее ───────────────────────────────────────────────────────────────
# Кому доступна /admin на стенде
ADMIN_EMAILS=

# Откуда пускают в /admin (адреса/CIDR через запятую). На стенде обычно пусто —
# ограничение по адресам нужно проду, см. .env.example
ADMIN_IPS=

# Пусто обязательно: иначе визиты на стенд попадут в продовый счётчик
METRIKA_ID=

# ops-mcp на стенде не поднимается, токен не нужен
OPS_MCP_TOKEN=

CSP_MODE=enforce
RATE_LIMIT_ENABLED=1
CLEANUP_INTERVAL_SEC=3600
ANON_USAGE_TTL_DAYS=30
EVENTS_TTL_DAYS=180
